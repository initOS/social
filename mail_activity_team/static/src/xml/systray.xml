<?xml version="1.0" encoding="UTF-8" ?>
<templates>

    <t t-inherit="mail.ActivityMenuView" t-inherit-mode="extension" owl="1">
        <xpath
            expr="//div[hasclass('o_ActivityMenuView_activityGroups')]"
            position="before"
        >
             <div class="o_mail_systray_dropdown_top">
                <nav class="nav nav-pills nav-fill">
                    <a
                        type="button"
                        class="nav-link active"
                        data-filter='my'
                        href="#"
                        t-on-click="activityMenuView.onClickDropdownToggle"
                    >
                    My Activities </a>
                    <a
                        type="button"
                        class="nav-link"
                        data-filter='team'
                        href="#"
                        t-on-click="activityMenuView.onClickDropdownToggle"
                    >
                    Team Activities </a>
                </nav>
            </div>
        </xpath>
    </t>
</templates>
